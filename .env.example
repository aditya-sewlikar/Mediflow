# Template only. Copy the values you need into .env (shared defaults) or
# .env.local (secrets). This file is committed and must never hold real secrets.

# --- Application ---
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-value
CLINIC_NAME=MediFlow Clinic
SUPPORT_EMAIL=support@mediflow.clinic
DISABLE_LOGIN=0
FLASK_DEBUG=0
SESSION_LIFETIME_SECONDS=43200

# --- Database: choose ONE of these styles ---
# Option A: a single connection string (recommended)
# MariaDB (also accepts mysql:// and mysql+pymysql://):
DATABASE_URL=mariadb+pymysql://mediflow:change-me@127.0.0.1:3306/mediflow?charset=utf8mb4
# Oracle (legacy):
# DATABASE_URL=oracle://clinic:change-me@localhost:1521/FREEPDB1

# Option B: manual fields (leave DATABASE_URL unset to use these)
# DB_BACKEND=mariadb
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=mediflow
# DB_USER=mediflow
# DB_PASSWORD=change-me
# DB_CHARSET=utf8mb4
# Oracle legacy fields:
# DB_BACKEND=oracle
# DB_USER=clinic
# DB_PASSWORD=change-me
# DB_DSN=localhost:1521/FREEPDB1

DB_POOL_MIN=1
DB_POOL_MAX=4
